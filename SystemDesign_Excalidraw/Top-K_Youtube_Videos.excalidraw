      "text": "- absorbs bursts and shields TSDB from hot shards.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- absorbs bursts and shields TSDB from hot shards.",
      "autoResize": true,
      "lineHeight": 1.25,
