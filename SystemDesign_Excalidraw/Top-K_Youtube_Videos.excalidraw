      "isDeleted": false,
      "id": "1VmmnCIyrov5UwbwwX8_c",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 129.89534089932204,
      "y": 75815.27749943393,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "width": 1864.4571397477225,
      "height": 61.71133844684122,
