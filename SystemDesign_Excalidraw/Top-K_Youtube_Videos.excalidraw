    {
      "id": "aelFwyGh6IIOg17ZMrDrX",
      "type": "text",
      "x": 1976.265966475254,
      "y": 87366.65712661664,
      "width": 179.77575285089316,
      "height": 30.895778415258953,
      "angle": 0,
      "strokeColor": "#2f9e44",
