    },
    {
      "id": "xl2Qn5GcOxI15njckkagA",
      "type": "text",
      "x": 1608.0605251632492,
      "y": 87462.01610293365,
      "width": 103.73994445800781,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbV",
      "roundness": null,
      "seed": 923496087,
      "version": 125,
      "versionNonce": 1340368697,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790100070085,
      "created": 1790100053317,
      "link": null,
      "locked": false,
      "text": "controlled \nadmit rate",
      "fontSize": 20,
      "baseFontSize": null,
