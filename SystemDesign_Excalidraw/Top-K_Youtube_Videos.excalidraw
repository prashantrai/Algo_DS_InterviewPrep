      "seed": 2069225437,
      "version": 218,
      "versionNonce": 468202579,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793732533083,
      "created": 1793732209031,
      "link": null,
      "locked": false,
      "text": "Back-of-the-envelope\nVehicles                         = 100,000\nLoads scheduled/day              = 500,000\nAverage load assignments/sec     = 500K / 86,400 ≈ 6/sec\n10x peak                         ≈ 60/sec\nGPS events from existing system  = 20,000/sec",
      "fontSize": 28.090575597746927,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Back-of-the-envelope\nVehicles                         = 100,000\nLoads scheduled/day              = 500,000\nAverage load assignments/sec     = 500K / 86,400 ≈ 6/sec\n10x peak                         ≈ 60/sec\nGPS events from existing system  = 20,000/sec",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
