      "index": "bSC",
      "roundness": null,
      "seed": 1855841179,
      "version": 1129,
      "versionNonce": 1621978542,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788724199376,
      "link": null,
      "locked": false,
      "text": "Locker sends physical events back \n(door opened/package inserted/closed)",
      "fontSize": 25.978290348981123,
      "fontFamily": 5,
