      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 218,
      "versionNonce": 273882729,
      "index": "aU",
      "isDeleted": false,
      "id": "7sxTpTXfUTIGWD2mx8BJe",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 972.09765625,
      "y": 490.0546875,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "width": 85.6639404296875,
      "height": 20,
      "seed": 1366113944,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1720053704996,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "single Node",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "single Node",
      "autoResize": true,
      "lineHeight": 1.25,
