    {
      "id": "a5lQWPSPXk8D9ayyZBbrl",
      "type": "text",
      "x": -666.7065824363126,
      "y": 66014.00405088146,
      "width": 1346.5435791015625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
