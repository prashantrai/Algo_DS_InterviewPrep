    {
      "id": "5I_y_w5B1ZwPXgXvVbn-B",
      "type": "text",
      "x": 1606.2582794659893,
      "y": 79931.96563555702,
      "width": 127.87207152630567,
      "height": 24.157192663331898,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTD",
