      "boundElements": [],
      "updated": 1788723872928,
      "link": null,
      "locked": false,
      "text": "CAS = Compare-And-Set: \nupdate the row only if it is still in \nthe state/version we expect.\nWe use a conditional update, or CAS, \nwhen moving SCHEDULED to READY.",
      "fontSize": 24.36746344223775,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CAS = Compare-And-Set: \nupdate the row only if it is still in \nthe state/version we expect.\nWe use a conditional update, or CAS, \nwhen moving SCHEDULED to READY.",
      "autoResize": true,
