    {
      "id": "-3cBf66bvNTPbVX4-fNoP",
      "type": "text",
      "x": 1586.9682514935002,
      "y": 62856.35350028664,
      "width": 578.1830385523052,
      "height": 73.31396285170042,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bML",
      "roundness": null,
      "seed": 384778705,
      "version": 729,
      "versionNonce": 1947828466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788724033354,
      "link": null,
      "locked": false,
      "text": "How It Achieves \"Asynchronous Shipping\"\nIn the sidecar implementation:",
      "fontSize": 29.325585140680165,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How It Achieves \"Asynchronous Shipping\"\nIn the sidecar implementation:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "fOqlH2VoqlNPgJFQPZz9H",
      "type": "text",
      "x": 1591.606028396021,
      "y": 62976.305783061405,
      "width": 768.3635389281926,
      "height": 560.3525335479102,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMN",
      "roundness": null,
      "seed": 1569243871,
      "version": 1148,
      "versionNonce": 2061843634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788758488497,
      "link": null,
      "locked": false,
      "text": "Gateway emits telemetry locally:\n- The Gateway sends metrics/logs/traces to \n   localhost where the sidecar is listening.\n- This is extremely fast (in-memory or very low\nlatency)\n\nGateway immediately continues:\n- The Gateway doesn't wait for acknowledgment \n  from the remote monitoring system.\n- It trusts the sidecar to handle the delivery.\n\nSidecar handles the heavy lifting:\n- Buffering, batching, retry logic\n- Network communication to the monitoring backend\n- Compression, authentication, etc.",
      "fontSize": 29.88546845588856,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gateway emits telemetry locally:\n- The Gateway sends metrics/logs/traces to \n   localhost where the sidecar is listening.\n- This is extremely fast (in-memory or very low latency)\n\nGateway immediately continues:\n- The Gateway doesn't wait for acknowledgment \n  from the remote monitoring system.\n- It trusts the sidecar to handle the delivery.\n\nSidecar handles the heavy lifting:\n- Buffering, batching, retry logic\n- Network communication to the monitoring backend\n- Compression, authentication, etc.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
