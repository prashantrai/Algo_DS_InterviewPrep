    {
      "id": "y0oPZojmPQgbF29PTiiLh",
      "type": "text",
      "x": 4442.560683652756,
      "y": 90242.44347063213,
      "width": 136.45993041992188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcr",
      "roundness": null,
      "seed": 1349142099,
      "version": 3,
      "versionNonce": 1792050003,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793729057562,
      "created": 1793729055565,
      "link": null,
      "locked": false,
      "text": "The Map API:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Map API:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0o5H7VJer1EhGFAcMAi_F",
      "type": "text",
      "x": 4332.260802671311,
      "y": 90277.44347063213,
      "width": 357.0596923828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcs",
      "roundness": null,
      "seed": 1996635229,
      "version": 3,
      "versionNonce": 1256869725,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793729057562,
      "created": 1793729055566,
      "link": null,
      "locked": false,
      "text": "1. Receives the dispatcher's request.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Receives the dispatcher's request.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "n_ebJtkMVUcJdro-pXSId",
      "type": "text",
      "x": 4126.760955259201,
      "y": 90299.94347063213,
      "width": 768.0593872070312,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bct",
      "roundness": null,
      "seed": 513016819,
      "version": 3,
      "versionNonce": 1797955827,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793729057562,
      "created": 1793729055566,
      "link": null,
      "locked": false,
      "text": "2. Checks PostgreSQL (or an appropriately maintained authorization cache) to\nconfirm the dispatcher belongs to the requested fleet.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Checks PostgreSQL (or an appropriately maintained authorization cache) to confirm the dispatcher belongs to the requested fleet.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CqWTfeqh9d6iczmwqs1eC",
      "type": "text",
      "x": 4184.800902768967,
      "y": 90372.44347063213,
      "width": 651.9794921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcu",
      "roundness": null,
      "seed": 1200924861,
      "version": 3,
      "versionNonce": 721574845,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793729057562,
      "created": 1793729055566,
      "link": null,
      "locked": false,
      "text": "3. If authorized, retrieves the latest vehicle positions from Redis.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. If authorized, retrieves the latest vehicle positions from Redis.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c5tnFMuabRVqfeCxCQiE0",
      "type": "text",
      "x": 4286.730788633225,
      "y": 90407.44347063213,
      "width": 448.1197204589844,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcv",
      "roundness": null,
      "seed": 670371219,
      "version": 3,
      "versionNonce": 1102056083,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1793729057562,
      "created": 1793729055566,
      "link": null,
      "locked": false,
      "text": "4. Returns those positions to the dispatcher.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Returns those positions to the dispatcher.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bYy0kW0zX6HWdJof3U_-a",
      "type": "text",
      "x": 3457.5415573458013,
      "y": 90107.21022099046,
      "width": 1352.0728658543592,
      "height": 253.51366234769247,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcw",
      "roundness": null,
      "seed": 1155348701,
      "version": 148,
      "versionNonce": 137512659,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793729385347,
      "created": 1793729058895,
      "link": null,
      "locked": false,
      "text": "The Map API:\n1. Receives the dispatcher's request.\n2. Checks PostgreSQL (or an appropriately maintained authorization cache) to\nconfirm the dispatcher belongs to the requested fleet.\n3. If authorized, retrieves the latest vehicle positions from Redis.\n4. Returns those positions to the dispatcher.",
      "fontSize": 33.801821646359,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Map API:\n1. Receives the dispatcher's request.\n2. Checks PostgreSQL (or an appropriately maintained authorization cache) to confirm the dispatcher belongs to the requested fleet.\n3. If authorized, retrieves the latest vehicle positions from Redis.\n4. Returns those positions to the dispatcher.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ej1HyDGOJ4pBpYF2jgkOl",
      "type": "text",
