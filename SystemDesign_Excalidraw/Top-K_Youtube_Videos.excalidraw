    {
      "type": "text",
      "version": 1369,
      "versionNonce": 949077102,
      "index": "bNq",
      "isDeleted": false,
      "id": "b0UR--FLBKQTdRZ-Xkk_A",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "x": 496.3818040567917,
      "y": 70977.96328427772,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
      "width": 1037.9422061316661,
