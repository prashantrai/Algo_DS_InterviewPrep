    {
      "id": "1BgXslWHOlB3Sj3Vuf6EP",
      "type": "text",
      "x": 3546.8308884623493,
      "y": 56736.38250727935,
      "width": 201.77766974278427,
      "height": 33.99678657135682,
      "angle": 0,
