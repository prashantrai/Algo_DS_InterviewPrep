    {
      "id": "BIwgexb9LRFHQNImiMHz2",
      "type": "text",
      "x": 2064.03014521871,
      "y": 88801.08059654807,
      "width": 1393.7146825757136,
      "height": 100.9119808407704,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bcp",
      "roundness": null,
      "seed": 1006861213,
      "version": 284,
      "versionNonce": 1346694899,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793729097106,
      "created": 1793728955599,
      "link": null,
      "locked": false,
      "text": "Conceptual flow. The Map API also checks fleet authorization against\nPostgreSQL, which is omitted here to keep the diagram focused.",
      "fontSize": 40.36479233630818,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Conceptual flow. The Map API also checks fleet authorization against PostgreSQL, which is omitted here to keep the diagram focused.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
