    {
      "id": "LCaYnGYPGoQxqKT-TYSuj",
      "type": "text",
      "x": 3672.4349488870666,
      "y": 92604.78073545048,
      "width": 1273.2583249528418,
      "height": 755.997130440749,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bd5",
      "roundness": null,
      "seed": 112528915,
      "version": 188,
      "versionNonce": 1441832147,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793732518883,
      "created": 1793732155467,
      "link": null,
      "locked": false,
      "text": "Functional requirements\nPriority        Requirement\nCORE        Create a load with pickup/drop-off locations, weight, volume, and\ntime windows.\nCORE        Find eligible trucks based on capacity, location, schedule, and route\ncompatibility.\nCORE        Assign loads without overbooking vehicle capacity or assigning the\nsame load twice.\nCORE        Track assignments, pickup/delivery status, and schedule deviations\nusing live GPS.\nFOLLOW-UP        Automatically optimize multi-stop routes across a fleet.\nFOLLOW-UP        Reassign loads when trucks break down or become unavailable.\n\nNon-functional requirements\n- Correctness: No double assignment or capacity overbooking.\n- Latency: Return candidate trucks within a few seconds under normal operating\nconditions.\n- Scalability: Support many concurrent dispatchers and independent fleet\noperators.",
      "fontSize": 31.831458123821044,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements\nPriority        Requirement\nCORE        Create a load with pickup/drop-off locations, weight, volume, and time windows.\nCORE        Find eligible trucks based on capacity, location, schedule, and route compatibility.\nCORE        Assign loads without overbooking vehicle capacity or assigning the same load twice.\nCORE        Track assignments, pickup/delivery status, and schedule deviations using live GPS.\nFOLLOW-UP        Automatically optimize multi-stop routes across a fleet.\nFOLLOW-UP        Reassign loads when trucks break down or become unavailable.\n\nNon-functional requirements\n- Correctness: No double assignment or capacity overbooking.\n- Latency: Return candidate trucks within a few seconds under normal operating conditions.\n- Scalability: Support many concurrent dispatchers and independent fleet operators.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZgE5PevbbPa6xkaXrZ60S",
      "type": "text",
      "x": 3683.7282266458183,
