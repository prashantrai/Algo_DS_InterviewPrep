      "text": "APIs\nPOST  /loads                               Create a shipment/load request\nGET   /loads/{loadId}/candidates     Find eligible trucks and ranked options\nPOST  /loads/{loadId}/assignments   Atomically reserve truck capacity\nPATCH /assignments/{id}/status       Accept, pick up, deliver, or cancel\n",
      "fontSize": 27.466757523090607,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs\nPOST  /loads                               Create a shipment/load request\nGET   /loads/{loadId}/candidates     Find eligible trucks and ranked options\nPOST  /loads/{loadId}/assignments   Atomically reserve truck capacity\nPATCH /assignments/{id}/status       Accept, pick up, deliver, or cancel\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
